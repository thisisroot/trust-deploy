# Trust deployment configuration — copy to .env and edit.

# Public domain for the instance (reverse proxy provisions HTTPS for this).
DOMAIN=chat.example.com

# Contact email for automatic TLS certificate issuance.
ACME_EMAIL=admin@example.com

# --- Database ---
DB_USER=trust
DB_PASSWORD=change-me
DB_NAME=trust

# --- Object storage (encrypted media blobs) ---
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
STORAGE_BUCKET=trust-media

# --- Cache / pub-sub ---
CACHE_PASSWORD=change-me

# --- SFU (call relay) ---
# Public IP or hostname clients reach the SFU on for WebRTC media.
SFU_PUBLIC_IP=

# --- Server ---
# Image tag; pin to a protocol-compatible release.
TRUST_SERVER_IMAGE=ghcr.io/trust/trust-server:latest
